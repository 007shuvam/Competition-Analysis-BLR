# Copy to .env and adjust as needed.

# SQLite by default; swap for a Postgres/MySQL connection string in production.
DATABASE_URL="file:./dev.db"

# Optional — point the bundled scraper adapters at real endpoints.
# Left unset, both adapters fall back to bundled sample fixtures.
# ADAPTER_JSON_FEED_URL="https://your-data-vendor.example.com/feed.json"
# ADAPTER_HTML_URL="https://example.com/bangalore-listings"
